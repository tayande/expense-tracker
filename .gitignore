# --- Python virtual environment ---
# Each developer builds their own venv from requirements.txt.
# Committing it adds thousands of files and breaks on other OSes/Python versions.
venv/
.venv/

# --- Python bytecode caches ---
# Auto-generated by Python every time code runs; never needs to be shared.
__pycache__/
*.pyc

# --- Secrets ---
# .env holds real keys (SECRET_KEY, BREVO_API_KEY, ANTHROPIC_API_KEY).
# Only .env.example (empty values) belongs in the repo.
.env

# --- Local data files ---
# Leftover data from the old JSON-based version / the CLI script.
# User data must never be in a public repo; cli_simple.py recreates
# expenses.json automatically when it's missing.
users.json
expenses.json

# --- Local SQLite database ---
# Used when DATABASE_URL is unset; contains real accounts and expenses.
*.db
*.sqlite3
instance/

# --- Test / tooling caches ---
.pytest_cache/

# --- Editor / OS clutter ---
.vscode/
.DS_Store
Thumbs.db
